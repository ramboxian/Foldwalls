# Cloudflare R2 server-side migration settings. Never expose credentials in the
# Sanity Studio browser bundle and never commit a real .env file. On macOS the
# uploader first uses the `com.foldwalls.r2` Keychain entry; the two credential
# variables below are only a CI/non-macOS fallback.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=foldwalls-media
R2_PUBLIC_BASE_URL=https://foldwalls-media.xianyubo201314.workers.dev
